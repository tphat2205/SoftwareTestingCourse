[
  {
    "tc_id": "TC_FR10_01",
    "description": "User cancel order: status=pending → canceled (success)",
    "type": "user_cancel",
    "inputs": {
      "setupOrderStatus": "pending",
      "action": "cancel"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order canceled successfully"
    }
  },
  {
    "tc_id": "TC_FR10_02",
    "description": "User cancel order: status=confirmed → canceled (success)",
    "type": "user_cancel",
    "inputs": {
      "setupOrderStatus": "confirmed",
      "action": "cancel"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order canceled successfully"
    }
  },
  {
    "tc_id": "TC_FR10_03",
    "description": "User cancel order: status=shipping → still allowed (SUT bug: should reject but allows)",
    "type": "user_cancel",
    "inputs": {
      "setupOrderStatus": "shipping",
      "action": "cancel"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order canceled successfully",
      "isBug": true,
      "bugDescription": "SUT allows canceling shipping orders. Backend checks only delivered/canceled, not shipping."
    }
  },
  {
    "tc_id": "TC_FR10_04",
    "description": "User cancel order: status=delivered → error (cannot cancel)",
    "type": "user_cancel",
    "inputs": {
      "setupOrderStatus": "delivered",
      "action": "cancel"
    },
    "expectedOutputs": {
      "httpStatus": 400,
      "message": "Cannot cancel this order."
    }
  },
  {
    "tc_id": "TC_FR10_05",
    "description": "User cancel order: status=canceled → error (already canceled)",
    "type": "user_cancel",
    "inputs": {
      "setupOrderStatus": "canceled",
      "action": "cancel"
    },
    "expectedOutputs": {
      "httpStatus": 400,
      "message": "Cannot cancel this order."
    }
  },
  {
    "tc_id": "TC_FR10_06",
    "description": "User cancel order: non-existent order ID → 404",
    "type": "user_cancel_nonexistent",
    "inputs": {
      "orderId": 99999,
      "action": "cancel"
    },
    "expectedOutputs": {
      "httpStatus": 404,
      "message": "Order not found"
    }
  },
  {
