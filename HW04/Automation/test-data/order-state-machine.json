  },
  {
    "tc_id": "TC_FR10_08",
    "description": "Admin update: pending → canceled (valid transition)",
    "type": "admin_update",
    "inputs": {
      "setupOrderStatus": "pending",
      "newStatus": "canceled"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order status updated"
    }
  },
  {
    "tc_id": "TC_FR10_09",
    "description": "Admin update: confirmed → shipping (valid transition)",
    "type": "admin_update",
    "inputs": {
      "setupOrderStatus": "confirmed",
      "newStatus": "shipping"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order status updated"
    }
  },
  {
    "tc_id": "TC_FR10_10",
    "description": "Admin update: shipping → delivered (valid transition)",
    "type": "admin_update",
    "inputs": {
      "setupOrderStatus": "shipping",
      "newStatus": "delivered"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order status updated"
    }
  },
  {
    "tc_id": "TC_FR10_11",
    "description": "Admin update: canceled → delivered (SUT bug: allows invalid transition)",
    "type": "admin_update",
    "inputs": {
      "setupOrderStatus": "canceled",
      "newStatus": "delivered"
    },
    "expectedOutputs": {
      "httpStatus": 200,
      "message": "Order status updated",
      "isBug": true,
      "bugDescription": "SUT allows transition from canceled to delivered. This is an intentional bug in the state machine."
    }
  },
  {
    "tc_id": "TC_FR10_12",
    "description": "Admin update: pending → delivered (invalid transition, should fail)",
    "type": "admin_update",
    "inputs": {
      "setupOrderStatus": "pending",
      "newStatus": "delivered"
    },
    "expectedOutputs": {
      "httpStatus": 400,
